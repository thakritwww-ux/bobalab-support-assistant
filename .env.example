# Copy to .env and edit locally. Never paste credentials into chat or commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PYTHON_VERSION=3.12.14
# Supabase Connect > Session pooler > URI. URL-encode password punctuation.
DATABASE_URL=
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
REVIEWER_API_KEY=
# Application budget controls; provider account quotas still apply.
DAILY_MODEL_CALL_LIMIT=100
REQUESTS_PER_MINUTE=10
MODEL_TIMEOUT_SECONDS=30

# Optional browser-only overrides. Leave empty to derive separate values from REVIEWER_API_KEY.
# Demo code: 8–128 characters, different from reviewer key. Signing secret: at least 32.
UI_DEMO_ACCESS_CODE=
UI_SESSION_SECRET=
# Render enables Secure cookies automatically. Set true for other HTTPS deployments.
UI_SECURE_COOKIE=false
